# Copy to .env and fill in values. .env is gitignored.

# OpenAI (Classification, Doc Ingest, Crawler all call chat_json)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Postgres
POSTGRES_USER=salespatriot
POSTGRES_PASSWORD=salespatriot
POSTGRES_DB=salespatriot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=salespatriot
RABBITMQ_PASSWORD=salespatriot
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# API
API_PORT=8000

# Web SPA
WEB_PORT=5173

# Uploads (mounted into api + workers as /data/uploads)
UPLOADS_DIR=./uploads
