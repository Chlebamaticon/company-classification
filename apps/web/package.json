{
  "name": "@salespatriot/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
